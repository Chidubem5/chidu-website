/*
  # Block your page from being embedded in iframes on other sites (clickjacking)
  X-Frame-Options: DENY

  # Stop browsers from guessing file types (MIME sniffing attacks)
  X-Content-Type-Options: nosniff

  # Control how much referrer info leaks when clicking outbound links
  Referrer-Policy: strict-origin-when-cross-origin

  # Force HTTPS for 1 year
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Limit which browser features the page can use
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Content Security Policy — controls what resources the page can load
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; media-src 'self'; frame-ancestors 'none'
